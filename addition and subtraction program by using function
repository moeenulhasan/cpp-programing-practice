#include <iostream>
using namespace std;
void add(int a, int b) 
{
    cout << "Sum: " << a + b << endl;
}
void subtract(int a, int b) 
{
    cout << "Difference: " << a - b << endl;
}
int main() 
{
    int num1, num2;
    cout << "Enter two numbers: ";
    cin >> num1 >> num2;
    
    add(num1, num2);
    subtract(num1, num2);
    
    return 0;
}
